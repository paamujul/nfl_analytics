# Copy to /etc/nfl-analytics.env (root-owned, chmod 640, group nflapp).

# Where nfl.db and the nflverse parquet cache live. Must match the systemd
# unit's ReadWritePaths.
STORAGE_DIR=/var/lib/nfl-analytics

# Seed the database on first boot (2025 nflverse + the live season from ESPN).
# Set to 0 once seeded if you'd rather control backfills by hand.
AUTO_SEED=1

# Postgres connection string. Leave unset for SQLite at $STORAGE_DIR/nfl.db,
# which is what a single-box deploy like this one wants.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Set 1 to stop live ESPN polling entirely.
# DISABLE_INGEST=1

# Only needed if the frontend is hosted on a different domain (e.g. Vercel).
# Serving the SPA from this same box needs no CORS config at all.
# ALLOWED_ORIGINS=https://your-app.vercel.app
